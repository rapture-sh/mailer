---
from: notifications
subject: Your booking for {activityName} is confirmed
fields:
  participants: number
sample:
  activityName: Kayak tour, Lake Thun
  participants: 3
  startsAt: 2026-07-02T08:00:00.000Z
  timezone: Europe/Zurich
  totalMinor: 12500
  currency: CHF
  tickets:
    - 2 Adult
    - 1 Child
---
{{#> layout heading="Booking confirmed" }}
  <p>{{ t "booking.intro" activityName=activityName participantCount=participants }}</p>
  <p>{{ date startsAt zone=timezone style="long" }}</p>
  <p>{{ list tickets }}</p>
  <p>{{ t "booking.paid" totalAmount=(money totalMinor currency) }}</p>
  {{#if voucherCode}}
    <p>Voucher {{ voucherCode }} applied.</p>
  {{/if}}
{{/layout}}
